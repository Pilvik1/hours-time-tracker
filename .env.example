# Copy this file to .env and replace every change-me value.
# The password is read from the environment secret, hashed with Argon2id in memory,
# and never stored in the repository or database.
TIME_TRACKER_PASSWORD=change-me
# Alternative: omit TIME_TRACKER_PASSWORD and set an Argon2id hash instead.
# TIME_TRACKER_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$...
TIME_TRACKER_SESSION_SECRET=change-me-use-at-least-32-random-characters
TIME_TRACKER_COOKIE_SECURE=false
TIME_TRACKER_SESSION_MAX_AGE_SECONDS=604800
TIME_TRACKER_TIMEZONE=UTC
TIME_TRACKER_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Local PostgreSQL settings used by Docker Compose.
POSTGRES_DB=timetracker
POSTGRES_USER=timetracker
POSTGRES_PASSWORD=change-me-database-password

# Frontend server-side API proxy. Docker Compose sets this automatically.
API_INTERNAL_URL=http://localhost:8000
